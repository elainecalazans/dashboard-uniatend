# Conta Gmail usada para enviar o relatório diário de auditoria
SMTP_USER=seu-email@gmail.com

# Senha de app do Google (não a senha da conta)
# Como gerar: Conta Google → Segurança → Verificação em duas etapas → Senhas de app
SMTP_PASS=xxxx xxxx xxxx xxxx

# Destinatário(s) do relatório — separar múltiplos por vírgula ou ponto-e-vírgula
REPORT_TO=lider@empresa.com,outro@empresa.com
